{
  "note": "opencc（cn→twp）在**命理语境**下的错误转写。做法：先整体转换，再用这些规则纠回。",
  "wrongToRight": [
    {
      "wrong": "藏幹",
      "right": "藏干",
      "why": "干支的「干」不是「幹」（trunk/cadre）"
    },
    {
      "wrong": "年幹",
      "right": "年干",
      "why": "同上"
    },
    {
      "wrong": "月幹",
      "right": "月干",
      "why": "同上"
    },
    {
      "wrong": "幹合",
      "right": "干合",
      "why": "同上"
    },
    {
      "wrong": "年乾",
      "right": "年干",
      "why": "opencc 会转成「乾」（乾坤的乾）；但 乾造/乾坤/乾燥/乾卦 是正确用法，需保留"
    },
    {
      "wrong": "月乾",
      "right": "月干",
      "why": "同上"
    },
    {
      "wrong": "藏乾",
      "right": "藏干",
      "why": "同上"
    },
    {
      "wrong": "刑衝",
      "right": "刑沖",
      "why": "命理一律用「沖」（相沖/沖剋），不用「衝」"
    },
    {
      "wrong": "醜",
      "right": "丑",
      "why": "地支「丑」不是「醜」（丑陋）。影响面最大：丑未沖/子丑合/丑戌未三刑/巳酉丑三合金局"
    }
  ],
  "regexRules": [
    {
      "pattern": "幹 → 干",
      "scope": "全局（本站内容不含 骨幹/幹部）"
    },
    {
      "pattern": "衝 → 沖",
      "scope": "全局（本站不用「衝撞」义）"
    },
    {
      "pattern": "乾(?!造|坤|燥|脆|旱|隆|卦) → 干",
      "scope": "否定前瞻保留本义用法"
    },
    {
      "pattern": "醜 → 丑",
      "scope": "全局"
    }
  ]
}
